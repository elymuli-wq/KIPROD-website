---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Risk Management Academy – KIPROD"
  description="The KIPROD Risk Management Academy builds practical credit risk capability across financial institutions through LMS learning, certification, and executive programmes."
  activePath="/academy"
>
  <section class="hero" style="min-height: 56vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 80px">
      <h1 class="hero-heading">Risk Management <em>Academy</em></h1>
      <p class="hero-sub">
        The Academy builds practical credit risk capability across financial institutions. It focuses on real-world
        application and decision-making, not just theory.
      </p>
      <div class="hero-actions">
        <a href="https://learning.kiprodrisk.com/" class="btn-primary" target="_blank" rel="noreferrer">Start Free Course →</a>
        <a href="/contact" class="btn-secondary">Request Programme Information →</a>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="section-inner">
      <div class="section-tag reveal">Learning model</div>
      <h2 class="section-heading reveal">Practical programmes built for <em>institutional teams</em>.</h2>
      <p class="section-sub reveal">
        Learning pathways include LMS-based learning, executive masterclasses, and role-based programmes tailored to how
        lending teams operate.
      </p>

      <div class="about-grid" style="grid-template-columns: 1fr 1fr">
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">LMS-Based Learning</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Self-paced modules</li>
            <li><span class="dot"></span>Scenario-based exercises</li>
            <li><span class="dot"></span>Assessments and certification</li>
          </ul>
        </div>
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Executive &amp; Role-Based Programmes</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Executive masterclasses (case discussions)</li>
            <li><span class="dot"></span>Credit teams and relationship managers</li>
            <li><span class="dot"></span>Recovery and legal teams</li>
          </ul>
        </div>
      </div>

      <div style="height: 16px"></div>
      <div class="mini-panel reveal" style="background: var(--cream)">
        <div class="mini-title">Featured Programme</div>
        <div class="mini-note"><strong>Fundamentals of Credit Risk Management (Institutional Edition)</strong></div>
        <div class="mini-note" style="margin-top: 8px">
          Build a strong foundation in credit risk across your team: practical lessons, real scenarios, and structured
          assessments.
        </div>
        <p style="margin-top: 10px">
          <a class="btn-primary" href="https://learning.kiprodrisk.com/" target="_blank" rel="noreferrer">Start Free Course →</a>
        </p>
      </div>
    </div>
  </section>

  <section
    class="about"
    style="
      padding-top: 70px;
      padding-bottom: 70px;
      background: var(--gold-pale);
      border-top: 1px solid rgba(196, 136, 42, 0.2);
    "
  >
    <div class="section-inner">
      <div class="section-tag reveal">Next</div>
      <h2 class="section-heading reveal">Move from learning to <em>system strengthening</em>.</h2>
      <p class="section-sub reveal">
        Once capability gaps are identified, institutions can move into structured support—governance review, portfolio
        insight, and implementation.
      </p>
      <div style="margin-top: 18px" class="reveal">
        <a class="nav-cta" href="/partnerships" style="text-decoration: none">Next: Institutional Partnerships →</a>
        <span style="display:inline-block; width: 10px"></span>
        <a href="https://learning.kiprodrisk.com/" class="arm-link" target="_blank" rel="noreferrer">Start Free Course →</a>
      </div>
    </div>
  </section>
</BaseLayout>

