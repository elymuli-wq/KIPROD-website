---
import BaseLayout from "../layouts/BaseLayout.astro";
import CapabilityPlatformLink from "../components/CapabilityPlatformLink.astro";
import FacultySection from "../components/FacultySection.astro";
import LmsProgrammeBlock from "../components/LmsProgrammeBlock.astro";
---

<BaseLayout
  title="Risk Management Academy – KIPROD"
  description="The KIPROD Risk Management Academy delivers capability development and institutional intelligence through the capability platform."
  activePath="/academy"
>
  <section class="hero" style="min-height: 56vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 80px">
      <h1 class="hero-heading">Risk Management <em>Academy</em></h1>
      <p class="hero-sub">
        Capability development and institutional intelligence infrastructure—the Academy pillar supporting governance
        visibility, operational maturity identification, and structured learning consistency.
      </p>
      <div class="hero-actions">
        <CapabilityPlatformLink class="btn-primary">Start Free Programme →</CapabilityPlatformLink>
        <a href="/contact" class="btn-secondary">Start Institutional Discussion →</a>
      </div>
    </div>
  </section>

  <section class="about" id="programme">
    <div class="section-inner">
      <div class="section-tag reveal">Capability platform</div>
      <h2 class="section-heading reveal">Built for <em>institutional teams</em></h2>
      <p class="section-sub reveal">
        Capability pathways include structured capability development through the platform, executive masterclasses,
        and role-based programmes tailored to how lending teams operate.
      </p>

      <div class="about-grid" style="grid-template-columns: 1fr 1fr">
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Capability Platform</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Self-paced modules</li>
            <li><span class="dot"></span>Scenario-based exercises</li>
            <li><span class="dot"></span>Assessments and certification</li>
          </ul>
        </div>
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Executive &amp; Role-Based Programmes</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Executive masterclasses (case discussions)</li>
            <li><span class="dot"></span>Credit teams and relationship managers</li>
            <li><span class="dot"></span>Recovery and legal teams</li>
          </ul>
        </div>
      </div>

      <div style="height: 16px"></div>
      <LmsProgrammeBlock variant="academy" />
    </div>
  </section>

  <FacultySection />

  <section
    class="about"
    style="
      padding-top: 70px;
      padding-bottom: 70px;
      background: var(--gold-pale);
      border-top: 1px solid rgba(196, 136, 42, 0.2);
    "
  >
    <div class="section-inner">
      <div class="section-tag reveal">Next</div>
      <h2 class="section-heading reveal">From capability to <em>operational strengthening</em></h2>
      <p class="section-sub reveal">
        Once capability gaps are identified, institutions can move into structured support—governance visibility review,
        portfolio risk visibility, and operational strengthening.
      </p>
      <div style="margin-top: 18px" class="reveal">
        <a class="nav-cta" href="/partnerships" style="text-decoration: none">Explore RMS Partnerships →</a>
        <span style="display:inline-block; width: 10px"></span>
        <CapabilityPlatformLink class="arm-link">Start Free Programme →</CapabilityPlatformLink>
      </div>
    </div>
  </section>
</BaseLayout>
