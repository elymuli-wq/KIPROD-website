---
import BaseLayout from "../layouts/BaseLayout.astro";
import CapabilityPlatformLink from "../components/CapabilityPlatformLink.astro";
import FacultySection from "../components/FacultySection.astro";
import LmsProgrammeBlock from "../components/LmsProgrammeBlock.astro";
---

<BaseLayout
  title="Risk Management Academy – KIPROD"
  description="The KIPROD Risk Management Academy delivers capability development and institutional intelligence through the capability platform."
  activePath="/academy"
>
  <section class="hero" style="min-height: 56vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 80px">
      <h1 class="hero-heading">
  Institutional Capability <em>Academy</em>
</h1>

<p class="hero-sub">
  The Academy is the capability development pillar of the KIPROD Institutional
  Engagement Methodology. Following ILCA, ICDF, and ICAR engagements, learning
  pathways are aligned to the institution’s identified governance, risk,
  operational, leadership, and performance priorities.
</p>

<div class="hero-actions">
  <a href="/contact?assessment=ilca" class="btn-primary">
    Start Institutional Capability Assessment →
  </a>

  <a href="/institute" class="btn-secondary">
    Explore the Institute Methodology →
  </a>
</div>
    </div>
  </section>

  <section class="about" id="programme">
    <div class="section-inner">
      <div class="section-tag reveal">Stage 5 · Capability Development</div>

<h2 class="section-heading reveal">
  Learning Aligned to <em>Assessment Findings</em>
</h2>

<p class="section-sub reveal">
  The Academy translates ICAR findings into structured capability development
  programmes. Learning interventions are selected based on institutional
  priorities, capability gaps, governance maturity, operational requirements,
  and the Learning & Advisory Roadmap developed through the KIPROD methodology.
</p>

      <div class="about-grid" style="grid-template-columns: 1fr 1fr">
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Capability Platform</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Governance & board effectiveness</li>
<li><span class="dot"></span>Credit risk & portfolio management</li>
<li><span class="dot"></span>Collections, recovery & legal execution</li>
<li><span class="dot"></span>Leadership, operations & performance management</li>
          </ul>
        </div>
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Executive &amp; Role-Based Programmes</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Executive masterclasses (case discussions)</li>
            <li><span class="dot"></span>Credit teams and relationship managers</li>
            <li><span class="dot"></span>Recovery and legal teams</li>
          </ul>
        </div>
      </div>

      <div style="height: 16px"></div>
      <div class="mini-panel reveal" style="background: var(--cream); margin-top: 20px;">
  <div class="mini-title">Methodology alignment</div>
  <div class="mini-note">
    Learning is not prescribed generically. Programmes are mapped to the
    institution’s ICAR findings, strategic priorities, governance observations,
    operational constraints, and capability roadmap, ensuring that development
    interventions are directly connected to measurable institutional outcomes.
  </div>
</div>
      <LmsProgrammeBlock variant="academy" />
    </div>
  </section>

  <FacultySection />

  <section
    class="about"
    style="
      padding-top: 70px;
      padding-bottom: 70px;
      background: var(--gold-pale);
      border-top: 1px solid rgba(196, 136, 42, 0.2);
    "
  >
    <div class="section-inner">
      <div class="section-tag reveal">Stage 6 · Implementation</div>

<h2 class="section-heading reveal">
  From Capability Development to <em>Institutional Execution</em>
</h2>

<p class="section-sub reveal">
  After capability priorities have been addressed through the Academy,
  institutions progress into RMS implementation support, where governance,
  operational, collections, portfolio, policy, and performance interventions
  are executed within a structured institutional strengthening framework.
</p>

<div style="margin-top: 18px" class="reveal">
  <a
    class="nav-cta"
    href="/partnerships"
    style="text-decoration: none"
  >
    Explore RMS Implementation Support →
  </a>

  <span style="display:inline-block; width: 10px"></span>

  <a href="/contact?assessment=ilca" class="arm-link">
    Begin with ILCA →
  </a>
</div>
    </div>
  </section>
</BaseLayout>
