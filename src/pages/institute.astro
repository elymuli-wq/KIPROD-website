---
import BaseLayout from "../layouts/BaseLayout.astro";
import InsightGrid from "../components/InsightGrid.astro";
import { getPublishedInsights } from "../lib/insights";

const insights = await getPublishedInsights();
---

<BaseLayout
  title="Credit Risk Institute – KIPROD"
  description="The KIPROD Credit Risk Institute provides governance visibility and executive insight—supporting institutional decision-making."
  activePath="/institute"
>
  <section class="page-header">
  <section class="page-hero page-hero--compact">
    <div class="hero-grid"></div>
    <div class="hero-glow hero-glow-left"></div>

    <div class="page-header-inner">
      <h1 class="page-heading">
  Institutional Insight &amp; <em>Capability Discovery</em>
</h1>
<div class="page-divider"></div>
      <p class="page-sub">
  The Institute is the insight engine of the KIPROD Institutional Engagement
  Methodology. Through structured discovery, governance analysis, portfolio
  intelligence, operational assessment, and executive research, we help
  institutions understand their current capability before recommending learning,
  advisory, or implementation interventions.
</p>
      <div class="page-actions">
  <a href="/contact?assessment=ilca" class="btn-primary">
    Start Institutional Capability Assessment →
  </a>

  <a href="/insights" class="btn-secondary">
    Explore Institute Insights →
  </a>
</div>
    </div>
  </section>

  <section class="about">
    <div class="section-inner">
      <div class="section-tag reveal">ICDF + ICAR</div>
<h2 class="section-heading reveal">
  How KIPROD Generates <em>Institutional Insight</em>
</h2>
      <p class="section-sub reveal">
  The Institute conducts Institutional Capability Discovery Framework (ICDF)
  engagements and produces Institutional Capability Assessment Reports (ICAR),
  combining governance analysis, portfolio observations, operational discovery,
  people capability assessment, and executive intelligence to generate
  evidence-based institutional recommendations.
</p>

      <div class="about-grid" style="grid-template-columns: 1fr 1fr">
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Focus areas</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Governance & board effectiveness</li>
<li><span class="dot"></span>Credit & portfolio capability</li>
<li><span class="dot"></span>Collections & operational execution</li>
<li><span class="dot"></span>People, learning & capability maturity</li>
<li><span class="dot"></span>Systems, visibility & performance intelligence</li>
          </ul>
        </div>
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Purpose</div>
          <div class="mini-note">
  ICAR engagements produce evidence-based institutional findings, capability
  gap analysis, strategic priorities, governance observations, operational
  insights, and executive recommendations that inform the Learning & Advisory
  Roadmap.

  <br /><br />

  <a class="arm-link" href="/insights">
    Explore the Institute Insights hub →
  </a>
</div>
        </div>
      </div>

      <div style="height: 20px"></div>
      <div class="section-tag reveal">Publications</div>
      <h2 class="section-heading reveal">
  Begin with <em>Institutional Understanding</em>
</h2>
      <p class="section-sub reveal">
  The Institute is the starting point of the KIPROD methodology. Through ILCA,
  ICDF, and ICAR engagements, institutions gain a structured understanding of
  governance, capability, operational, and strategic priorities before
  progressing into learning, advisory, implementation, and continuous
  performance support.
</p>

      <InsightGrid posts={insights} columns={2} />

      <div style="height: 16px"></div>
      <div class="mini-panel reveal" style="background: var(--cream)">
        <div class="mini-title">Institutional assets</div>
        <div class="mini-note">
          Download governance visibility one-pagers, RMS partnership materials, and capability platform welcome packs from
          the resources hub.
        </div>
        <p style="margin-top: 12px">
          <a class="arm-link" href="/resources">View resources &amp; downloads →</a>
        </p>
      </div>
    </div>
  </section>

  <section
    class="about"
    style="
      padding-top: 70px;
      padding-bottom: 70px;
      background: var(--gold-pale);
      border-top: 1px solid rgba(196, 136, 42, 0.2);
    "
  >
    <div class="section-inner">
      <div class="section-tag reveal">Next</div>
      <h2 class="section-heading reveal">Make it practical—<em>start a discussion</em></h2>
      <p class="section-sub reveal">
        To explore governance visibility review, capability development, or operational strengthening for your
        institution, the next step is a confidential institutional discussion.
      </p>
      <div style="margin-top: 18px" class="reveal">
  <a
    class="nav-cta"
    href="/contact?assessment=ilca"
    style="text-decoration: none"
  >
    Start Institutional Capability Assessment →
  </a>

  <span style="display:inline-block; width: 10px"></span>

  <a href="/academy" class="arm-link">
    Continue to the Academy →
  </a>
</div>
    </div>
  </section>
</BaseLayout>
