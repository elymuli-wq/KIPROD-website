---
import BaseLayout from "../layouts/BaseLayout.astro";
import InsightGrid from "../components/InsightGrid.astro";
import { getPublishedInsights } from "../lib/insights";

const insights = await getPublishedInsights();
---

<BaseLayout
  title="Credit Risk Institute – KIPROD"
  description="The KIPROD Credit Risk Institute provides governance visibility and executive insight—supporting institutional decision-making."
  activePath="/institute"
>
  <section class="hero" style="min-height: 56vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 80px">
      <h1 class="hero-heading">Credit Risk <em>Institute</em></h1>
      <p class="hero-sub">
        Governance visibility and executive insight for financial institutions—supporting leadership with decision-useful
        intelligence across governance perspectives, portfolio observations, and sector developments.
      </p>
      <div class="hero-actions">
        <a href="/insights" class="btn-primary">Read Insights →</a>
        <a href="/contact" class="btn-secondary">Start Institutional Discussion →</a>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="section-inner">
      <div class="section-tag reveal">Overview</div>
      <h2 class="section-heading reveal">Governance visibility for <em>executives and boards</em></h2>
      <p class="section-sub reveal">
        The Institute focuses on governance perspectives, portfolio risk observations, sector intelligence, and executive
        reflections—delivered as practical briefs and publications through the Insights hub.
      </p>

      <div class="about-grid" style="grid-template-columns: 1fr 1fr">
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Focus areas</div>
          <ul class="bullets" style="margin-top: 14px">
            <li><span class="dot"></span>Governance perspectives</li>
            <li><span class="dot"></span>Portfolio risk observations</li>
            <li><span class="dot"></span>Sector intelligence</li>
            <li><span class="dot"></span>Executive reflections</li>
          </ul>
        </div>
        <div class="mini-panel reveal" style="background: var(--cream)">
          <div class="mini-title">Purpose</div>
          <div class="mini-note">
            To support leadership teams in understanding evolving risk dynamics and making informed decisions—with an
            executive, institutional tone. Not generic commentary or blog-style content.
            <br /><br />
            <a class="arm-link" href="/insights">Explore the Insights hub →</a>
          </div>
        </div>
      </div>

      <div style="height: 20px"></div>
      <div class="section-tag reveal">Publications</div>
      <h2 class="section-heading reveal">Executive briefs &amp; insight series</h2>
      <p class="section-sub reveal">
        Decision-useful governance intelligence from the Institute—linked directly to the Insights collection.
      </p>

      <InsightGrid posts={insights} columns={2} />

      <div style="height: 16px"></div>
      <div class="mini-panel reveal" style="background: var(--cream)">
        <div class="mini-title">Institutional assets</div>
        <div class="mini-note">
          Download governance visibility one-pagers, RMS partnership materials, and capability platform welcome packs from
          the resources hub.
        </div>
        <p style="margin-top: 12px">
          <a class="arm-link" href="/resources">View resources &amp; downloads →</a>
        </p>
      </div>
    </div>
  </section>

  <section
    class="about"
    style="
      padding-top: 70px;
      padding-bottom: 70px;
      background: var(--gold-pale);
      border-top: 1px solid rgba(196, 136, 42, 0.2);
    "
  >
    <div class="section-inner">
      <div class="section-tag reveal">Next</div>
      <h2 class="section-heading reveal">Make it practical—<em>start a discussion</em></h2>
      <p class="section-sub reveal">
        To explore governance visibility review, capability development, or operational strengthening for your
        institution, the next step is a confidential institutional discussion.
      </p>
      <div style="margin-top: 18px" class="reveal">
        <a class="nav-cta" href="/contact" style="text-decoration: none">Start Institutional Discussion →</a>
        <span style="display:inline-block; width: 10px"></span>
        <a href="/academy" class="arm-link">Or: Explore the Academy →</a>
      </div>
    </div>
  </section>
</BaseLayout>
