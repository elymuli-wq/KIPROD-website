---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InsightGrid from "../../components/InsightGrid.astro";
import { getPublishedInsights, groupInsightsByTopic, INSIGHT_TOPIC_ORDER, topicLabel } from "../../lib/insights";

const insights = await getPublishedInsights();
const topicSections = groupInsightsByTopic(insights);
---

<BaseLayout
  title="Insights – KIPROD"
  description="Executive governance intelligence from KIPROD—governance perspectives, portfolio observations, and sector intelligence."
  activePath="/insights"
>
  <section class="about" style="padding-top:140px;">

  <div class="section-inner">

    <div class="section-tag reveal">
      Insights Centre
    </div>

    <h1 class="section-heading reveal">
      Insights &
      <em>Executive Intelligence</em>
    </h1>

    <p class="section-sub reveal">
      Executive governance intelligence for boards, executive leadership,
      financial institutions and regulators. Explore practical perspectives,
      portfolio observations, institutional capability discussions and
      governance thought leadership from across the KIPROD ecosystem.
    </p>

    <div class="page-actions reveal">

      <a
        href="/institute"
        class="btn-primary"
      >
        Explore the Institute →
      </a>

      <a
        href="/contact"
        class="btn-secondary"
      >
        Start Institutional Discussion →
      </a>

    </div>

  </div>

</section>

  <section class="about" style="background: var(--white); padding-top:40px;">
    <div class="section-inner">
      <div class="section-tag reveal">Content types</div>
      <h2 class="section-heading reveal">Executive governance intelligence</h2>
      <p class="section-sub reveal">
        Insights are decision-useful briefs for executives, boards, and institutional leaders—not a generic blog. Content
        is organised by topic aligned to the Credit Risk Institute.
      </p>

      <div class="insight-topics-key reveal">
        {
          INSIGHT_TOPIC_ORDER.map((topic) => (
            <span class="insight-topic-key">{topicLabel(topic)}</span>
          ))
        }
      </div>

      {
        topicSections.map((section) => (
          <div class="insight-topic-section">
            <h3 class="insight-topic-heading reveal">{section.label}</h3>
            <InsightGrid posts={section.posts} columns={2} showTopic={false} />
          </div>
        ))
      }

      <div style="height: 16px"></div>
      <div class="mini-panel reveal" style="background: var(--cream)">
        <div class="mini-title">Apply this to your institution</div>
        <div class="mini-note">
          If you want to discuss how these perspectives apply to your institution's portfolio and governance routines,
          start an institutional discussion.
        </div>
        <div style="margin-top: 16px">
          <a class="btn-primary" href="/contact">Start Institutional Discussion →</a>
          <span style="display:inline-block;width:10px"></span>
          <a class="btn-secondary" href="/partnerships">See engagement model →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .insight-topics-key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 40px;
  }
  .insight-topic-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--cream);
    border: 1px solid rgba(9, 34, 74, 0.1);
    padding: 8px 12px;
  }
  .insight-topic-section {
    margin-bottom: 48px;
  }
  .insight-topic-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 20px;
  }
</style>
