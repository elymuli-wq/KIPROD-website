---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Media Centre | KIPROD"
  description="Executive interviews, institutional conversations, testimonials and workshop highlights."
  activePath="/media"
>

<section class="page-header">



  <div class="page-header-inner">

    <div class="section-tag">
      Media Centre
    </div>

    <h1 class="page-heading">
      Executive <em>Media</em>
    </h1>
    <div class="page-divider"></div>

    <p class="page-sub">
      Watch executive interviews, institutional conversations,
      client testimonials, workshop highlights and capability
      development sessions from KIPROD.
    </p>

  </div>

</section>

<section class="about">

<div class="section-inner">

<div class="section-tag reveal">
Featured Videos
</div>

<h2 class="section-heading reveal">
Learn directly from <em>KIPROD engagements</em>
</h2>

<p class="section-sub reveal">
Executive interviews, client experiences, and professional development
sessions that demonstrate KIPROD's institutional approach.
</p>

<div class="download-grid">

  <!-- Training -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/2zCQtv5XnTY/hqdefault.jpg"
        alt="Executive Training"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Training
      </div>

      <h3>
        Executive Training Programme
      </h3>

      <p>
        Professional capability development covering credit risk,
        governance, institutional performance and executive leadership.
      </p>

      <a
        href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

  <!-- Testimonial -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/U2tD0JDMHTs/hqdefault.jpg"
        alt="Client Testimonial"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Testimonial
      </div>

      <h3>
        Institutional Experience
      </h3>

      <p>
        Hear directly from institutions and participants who have
        benefited from KIPROD programmes.
      </p>

      <a
        href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

  <!-- Workshop -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/7VfeeHqbAeY/hqdefault.jpg"
        alt="Workshop Highlights"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Workshop
      </div>

      <h3>
        Executive Workshop Highlights
      </h3>

      <p>
        Highlights from institutional workshops, executive discussions
        and practical capability development sessions.
      </p>

      <a
        href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

</div>

<div style="text-align:center; margin-top:60px;" class="reveal">

<a
href="https://www.youtube.com/@kiprod_rms"
target="_blank"
class="btn-primary"
>

Visit the Official KIPROD YouTube Channel →

</a>

</div>

</div>

</section>

</BaseLayout>
