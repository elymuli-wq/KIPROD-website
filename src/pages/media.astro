---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Media Centre | KIPROD"
  description="Executive interviews, institutional conversations, testimonials and workshop highlights."
  activePath="/media"
>

<section class="page-header">

  <div class="section-inner">

    <div class="section-tag">
      Media Centre
    </div>

    <h1 class="section-heading">
      Executive Media &
      <em>Institutional Engagements</em>
    </h1>

    <p class="section-sub">
      Explore executive interviews, governance discussions, institutional
      workshops and capability development sessions from across the
      KIPROD ecosystem.
    </p>

  </div>

</section>

<section class="featured-video">

<div class="section-inner">

<div class="featured-video-card">

<div class="featured-video-image">

<img
src="https://img.youtube.com/vi/2zCQtv5XnTY/maxresdefault.jpg"
alt="Executive Training"
/>

<a
href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
target="_blank"
class="play-large"
>

▶

</a>

</div>

<div class="featured-video-content">

<div class="pill">
Featured Session
</div>

<h2>

Executive Training Programme

</h2>

<p>

A comprehensive executive programme focused on governance,
credit risk management, institutional capability development
and sustainable organisational performance.

</p>

<div class="video-meta">

<span>🎥 Executive Training</span>

<span>YouTube</span>

</div>

<a
href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
target="_blank"
class="btn-primary"
>

Watch Featured Video →

</a>

</div>

</div>

</div>

</section>

<section class="about">

<div class="section-inner">

<div class="section-tag reveal">
Latest Executive Sessions
</div>

<h2 class="section-heading reveal">
Learn directly from <em>KIPROD engagements</em>
</h2>

<p class="section-sub reveal">
Executive interviews, client experiences, and professional development
sessions that demonstrate KIPROD's institutional approach.
</p>

<div class="media-grid">

  <!-- Training -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/2zCQtv5XnTY/hqdefault.jpg"
        alt="Executive Training"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Training
      </div>

      <h3>
        Executive Training Programme
      </h3>

      <p>
        Professional capability development covering credit risk,
        governance, institutional performance and executive leadership.
      </p>

      <a
        href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

  <!-- Testimonial -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/U2tD0JDMHTs/hqdefault.jpg"
        alt="Client Testimonial"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Testimonial
      </div>

      <h3>
        Institutional Experience
      </h3>

      <p>
        Hear directly from institutions and participants who have
        benefited from KIPROD programmes.
      </p>

      <a
        href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

  <!-- Workshop -->

  <div class="video-card reveal">

    <a
      href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
      target="_blank"
      rel="noopener noreferrer"
      class="video-thumb"
    >

      <img
        src="https://img.youtube.com/vi/7VfeeHqbAeY/hqdefault.jpg"
        alt="Workshop Highlights"
      />

      <div class="play-icon">▶</div>

    </a>

    <div class="video-body">

      <div class="pill">
        Workshop
      </div>

      <h3>
        Executive Workshop Highlights
      </h3>

      <p>
        Highlights from institutional workshops, executive discussions
        and practical capability development sessions.
      </p>

      <a
        href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
        target="_blank"
        class="arm-link"
      >
        Watch Video →
      </a>

    </div>

  </div>

</div>

<div style="text-align:center; margin-top:60px;" class="reveal">

<a
href="https://www.youtube.com/@kiprod_rms"
target="_blank"
class="btn-primary"
>

Visit the Official KIPROD YouTube Channel →

</a>

</div>

</div>

</section>
<section class="about" style="background:var(--cream);">

  <div class="section-inner">

    <div class="section-tag reveal">
      Explore
    </div>

    <h2 class="section-heading reveal">
      Browse by <em>Category</em>
    </h2>

    <p class="section-sub reveal">
      Discover executive content organised by institutional focus area.
    </p>

    <div class="category-grid">

      <div class="category-card reveal">
        <span>🎓</span>
        <h3>Executive Training</h3>
      </div>

      <div class="category-card reveal">
        <span>🏛</span>
        <h3>Governance</h3>
      </div>

      <div class="category-card reveal">
        <span>🎤</span>
        <h3>Interviews</h3>
      </div>

      <div class="category-card reveal">
        <span>📊</span>
        <h3>Case Studies</h3>
      </div>

      <div class="category-card reveal">
        <span>🎥</span>
        <h3>Workshops</h3>
      </div>

    </div>

  </div>

</section>

<section class="about">

<div class="section-inner">

<div class="section-tag reveal">
Gallery
</div>

<h2 class="section-heading reveal">
Institutional <em>Moments</em>
</h2>

<p class="section-sub reveal">

Real executive engagements,
professional workshops,
board discussions and capability development sessions.

</p>

<div class="gallery-grid">

<div class="gallery-item reveal">
Workshop
</div>

<div class="gallery-item reveal">
Board Session
</div>

<div class="gallery-item reveal">
Executive Dialogue
</div>

<div class="gallery-item reveal">
Training Programme
</div>

</div>

</div>

</section>

<section class="institutional">

<div class="section-inner">

<div class="section-tag reveal">
KIPROD Impact
</div>

<h2 class="section-heading reveal">

Building Institutional
<em>Capability</em>

</h2>

<div class="stats-grid">

<div class="stat-card reveal">

<h2>1500+</h2>

<p>Executives Trained</p>

</div>

<div class="stat-card reveal">

<h2>120+</h2>

<p>Institutions Served</p>

</div>

<div class="stat-card reveal">

<h2>30+</h2>

<p>Executive Workshops</p>

</div>

<div class="stat-card reveal">

<h2>7</h2>

<p>Institutional Framework Stages</p>

</div>

</div>

</div>

</section>

<section class="about" style="padding-top:0;">

<div class="section-inner">

<div class="featured-resource-card">

<div class="featured-left">

<div class="pill">

Media Centre

</div>

<h2>

Continue Learning on YouTube

</h2>

<p>

Watch executive interviews,
governance discussions,
institutional capability sessions
and workshop highlights from KIPROD.

</p>

<a

href="https://www.youtube.com/@kiprod_rms"

target="_blank"

class="btn-primary"

>

Visit Official YouTube Channel →

</a>

</div>

<div class="featured-right">

<div class="featured-stat">

<span class="number">100%</span>

<span class="label">

Free Educational Content

</span>

</div>

</div>

</div>

</div>

</section>

</BaseLayout>
