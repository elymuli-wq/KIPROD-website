---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact – KIPROD"
  description="Contact KIPROD for enquiries, programme information, or institutional discussions."
  activePath="/contact"
>
  <section class="hero" style="min-height: 42vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 70px">
      <h1 class="hero-heading">
        Contact <span style="color: var(--gold-light)">KIPROD</span>
      </h1>
      <p class="hero-sub">For enquiries, programme information, or institutional discussions, please contact us.</p>
    </div>
  </section>

  <section class="institutional" style="border-top: 0">
    <div class="section-inner">
      <div class="institutional-inner">
        <div>
          <div class="section-tag reveal">Contact</div>
          <h2 class="section-heading reveal">Request a <em>Meeting</em></h2>
          <p class="inst-desc reveal">
            Use the form to request an institutional discussion. We keep inquiries confidential and can structure
            engagements under NDA where appropriate.
          </p>
          <p class="inst-desc reveal">
            Email: <strong>advisory@kiprod.org</strong>
            <br />
            Regional Hub: <strong>Johannesburg, ZA</strong>
          </p>
        </div>

        <div class="inst-form reveal">
          <div class="form-heading">Institutional Discussion Request</div>
          <div class="form-sub">Required fields (exact list from the questionnaire).</div>

          <form>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Full Name *</label>
                <input class="form-input" type="text" name="full_name" required placeholder="John Martin Ambetsa" />
              </div>
              <div class="form-group">
                <label class="form-label">Institution Name *</label>
                <input class="form-input" type="text" name="institution_name" required placeholder="Your Institution" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Role / Title *</label>
                <input class="form-input" type="text" name="role_title" required placeholder="CEO / Credit Manager" />
              </div>
              <div class="form-group">
                <label class="form-label">Email Address *</label>
                <input class="form-input" type="email" name="email" required placeholder="you@institution.org" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Phone Number *</label>
                <input class="form-input" type="tel" name="phone" required placeholder="+254 700 000 000" />
              </div>
              <div class="form-group">
                <label class="form-label">Type of Institution (Dropdown) *</label>
                <select class="form-select" name="institution_type" required>
                  <option value="" disabled selected>Select type</option>
                  <option value="Bank">Bank</option>
                  <option value="Sacco">Sacco</option>
                  <option value="Microfinance">Microfinance</option>
                  <option value="Fintech">Fintech</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Area of Interest (Dropdown) *</label>
              <select class="form-select" name="area_of_interest" required>
                <option value="" disabled selected>Select area</option>
                <option value="Credit Risk Governance Review">Credit Risk Governance Review</option>
                <option value="Portfolio Diagnostics">Portfolio Diagnostics</option>
                <option value="Training / Academy">Training / Academy</option>
                <option value="Full Partnership">Full Partnership</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Brief Description of Need *</label>
              <textarea
                class="form-textarea"
                name="need_description"
                required
                placeholder="Briefly describe what you're looking to address..."
              ></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Preferred Meeting Time *</label>
              <input
                class="form-input"
                type="text"
                name="preferred_meeting_time"
                required
                placeholder="e.g. Weekday mornings, afternoons"
              />
            </div>

            <button type="submit" class="form-submit">Submit Request →</button>
            <div class="form-sub" style="margin-top: 10px">
              By submitting, you are requesting a meeting. We respond within 2 business days.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="institutional" style="padding-top: 70px; padding-bottom: 70px">
    <div class="section-inner">
      <div class="section-tag reveal">What happens next</div>
      <h2 class="section-heading reveal">Simple and confidential.</h2>
      <p class="section-sub reveal">
        We confirm scope, propose times, and share the next steps for an appropriate engagement pathway (starting from
        Phase 0 if needed).
      </p>
      <div style="margin-top: 18px" class="reveal">
        <a href="/" class="nav-cta" style="text-decoration: none">Back to Homepage →</a>
        <span style="display:inline-block; width: 10px"></span>
        <a href="/partnerships" class="arm-link">Review engagement phases →</a>
      </div>
    </div>
  </section>
</BaseLayout>

