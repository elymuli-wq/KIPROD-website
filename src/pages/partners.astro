---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Institutional Partners | KIPROD"
  description="Institutions that have partnered with KIPROD in strengthening credit risk capability, governance, and institutional performance."
  activePath="/partners"
>

<section class="hero hero-single">

<div class="hero-grid"></div>
<div class="hero-glow hero-glow-left"></div>

<div class="hero-glow hero-glow-right"></div>

<div class="hero-inner" style="padding-bottom:80px">

<div class="section-tag">
Institutional Portfolio
</div>

<h1 class="hero-heading">

Institutions We've
<em>Worked With</em>

</h1>
<div class="hero-divider"></div>

<p class="hero-sub">

KIPROD works alongside banks, SACCOs, microfinance institutions,
government agencies, regulators, and development partners to strengthen
institutional capability, governance, and operational performance.

</p>

<div class="hero-actions">

<a href="/contact" class="btn-primary">
Become an Institutional Partner →
</a>

<a href="/resources" class="btn-secondary">
Download Company Profile →
</a>

</div>

</div>

</section>

<section class="about">

<div class="section-inner">

<div class="section-tag reveal">
