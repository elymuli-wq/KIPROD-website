---
import BaseLayout from "../layouts/BaseLayout.astro";
import CapabilityPlatformLink from "../components/CapabilityPlatformLink.astro";
import InsightGrid from "../components/InsightGrid.astro";
import LmsProgrammeBlock from "../components/LmsProgrammeBlock.astro";
import { getPublishedInsights } from "../lib/insights";

const featuredInsights = (await getPublishedInsights()).slice(0, 3);
---

<BaseLayout
  title="KIPROD – Strengthening Credit Risk. Building Resilient Institutions."
  description="KIPROD is an integrated institutional credit risk ecosystem focused on governance visibility, capability development, operational strengthening, and portfolio resilience."
  activePath="/"
>
  <section class="hero" id="top">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/videos/abstract-network-optimized.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-glow-2"></div>

    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-heading">
          Strengthening Credit Risk.<br />
          Building <em>Resilient Institutions</em>.
        </h1>
        <p class="hero-sub">
          From institutional capability development to governance visibility, operational strengthening, and
          long-term portfolio resilience.
        </p>
        <p class="hero-insight">
          Strong portfolio performance requires more than policy. It requires governance visibility, structured
          systems, and disciplined execution.
        </p>
        <div class="hero-actions">
          <CapabilityPlatformLink class="btn-primary">
            Start Free Credit Risk Programme <span class="btn-arrow">→</span>
          </CapabilityPlatformLink>
          <a href="/contact" class="btn-secondary">
            Start Institutional Discussion <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="KIPROD overview visual">
        <div class="hero-visual-inner">
          <div class="hero-visual-label">Institutional pathways</div>
          <div class="hero-visual-title">From Insight → Capability → Execution</div>
          <div class="hero-visual-sub">Designed for banks, SACCOs, microfinance institutions, and fintech lenders.</div>

          <div class="hero-visual-grid" role="list">
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Insight</div>
                <div class="chip-desc">Governance visibility &amp; executive intelligence</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Capability</div>
                <div class="chip-desc">Institutional capability development</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Visibility</div>
                <div class="chip-desc">Structured governance visibility review</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Strengthen</div>
                <div class="chip-desc">Operational strengthening support</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Sustain</div>
                <div class="chip-desc">Continuous ecosystem support</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Two pathways</div>
                <div class="chip-desc">Programme entry + institutional discussion</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="executive-insight-strip" aria-label="Executive insight">
    <div class="section-inner">
      <p class="executive-insight-text reveal">
        Strong credit policies alone do not guarantee portfolio quality. Many portfolio challenges emerge where
        monitoring, governance, escalation, and operational systems are not sufficiently structured.
      </p>
    </div>
  </section>

  <section class="about" id="institutional-challenge">
    <div class="section-inner">
      <div class="section-tag reveal">Institutional challenge</div>
      <h2 class="section-heading reveal">Why Portfolio Deterioration Often Happens Late</h2>
      <p class="section-sub reveal">
        Demonstrating understanding of institutional operational realities—where execution gaps undermine portfolio
        quality despite sound policy frameworks.
      </p>

      <div class="about-grid">
        <div class="about-text reveal">
          <ul class="bullets">
            <li><span class="dot"></span>Delayed risk visibility</li>
            <li><span class="dot"></span>Inconsistent monitoring</li>
            <li><span class="dot"></span>Weak escalation discipline</li>
            <li><span class="dot"></span>Fragmented restructuring</li>
            <li><span class="dot"></span>Reactive recovery systems</li>
          </ul>
        </div>

        <div class="mini-panel reveal">
          <div class="mini-title">Who we serve</div>
          <div class="mini-note">
            Banks, SACCOs, microfinance institutions, and fintech lenders—starting in Kenya and East Africa.
            <br /><br />
            Primary audience: institutions and executives. Capability pathway entry via the Academy capability platform.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="approach" style="background: var(--cream)">
    <div class="section-inner">
      <div class="section-tag reveal">Our approach</div>
      <h2 class="section-heading reveal">An institutional strengthening <em>ecosystem</em></h2>
      <p class="section-sub reveal">
        KIPROD supports financial institutions in strengthening governance visibility, operational execution, and
        institutional credit risk maturity across the lending lifecycle.
      </p>

      <div class="about-grid">
        <div class="about-text reveal">
          <p>
            KIPROD operates as integrated institutional operating infrastructure—not isolated interventions or generic
            advisory engagements.
          </p>
        </div>
        <div class="mini-panel reveal">
          <div class="mini-title">Two entry pathways</div>
          <div class="mini-note">
            Start with capability development through the free programme, then progress into governance visibility
            review and operational strengthening.
            <br /><br />
            <a class="arm-link" href="/academy">Explore the Academy →</a>
            <br />
            <a class="arm-link" href="/contact">Start Institutional Discussion →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="arms" id="ecosystem">
    <div class="section-inner">
      <div class="section-tag reveal">The KIPROD ecosystem</div>
      <h2 class="section-heading reveal">Institute. <em>Academy.</em> RMS.</h2>
      <p class="section-sub reveal">
        One integrated ecosystem with three pillars—supporting institutions from insight through capability to
        operational execution.
      </p>

      <div class="arms-grid">
        <div class="arm-card reveal">
          <div class="arm-tag">Insight</div>
          <div class="arm-name">Credit Risk Institute</div>
          <div class="arm-desc">Insight and governance visibility—executive briefs and decision-useful intelligence.</div>
          <a class="arm-link" href="/institute">Explore the Institute →</a>
        </div>
        <div class="arm-card reveal">
          <div class="arm-tag">Capability</div>
          <div class="arm-name">Risk Management Academy</div>
          <div class="arm-desc">Capability development and institutional intelligence through the capability platform.</div>
          <a class="arm-link" href="/academy">Explore the Academy →</a>
        </div>
        <div class="arm-card reveal">
          <div class="arm-tag">Execution</div>
          <div class="arm-name">RMS Institutional Partnerships</div>
          <div class="arm-desc">Operational strengthening and continuous support for institutional partners.</div>
          <a class="arm-link" href="/partnerships">Explore RMS Partnerships →</a>
        </div>
      </div>

      <div class="arch-wrap reveal" aria-label="KIPROD brand architecture">
        <svg class="arch-svg" viewBox="0 0 920 260" role="img" aria-label="KIPROD with three integrated components">
          <defs>
            <linearGradient id="archStroke" x1="0" x2="1">
              <stop offset="0" stop-color="#C4882A" stop-opacity="0.85" />
              <stop offset="1" stop-color="#E8B455" stop-opacity="0.85" />
            </linearGradient>
            <filter id="soft" x="-10%" y="-20%" width="120%" height="140%">
              <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#09224a" flood-opacity="0.10" />
            </filter>
          </defs>

          <rect x="310" y="20" width="300" height="70" rx="6" fill="#09224A" filter="url(#soft)" />
          <text
            x="460"
            y="55"
            text-anchor="middle"
            font-family="DM Sans, Arial, sans-serif"
            font-size="18"
            fill="#FFFFFF"
            font-weight="600"
          >
            KIPROD
          </text>
          <text
            x="460"
            y="76"
            text-anchor="middle"
            font-family="DM Mono, Arial, monospace"
            font-size="10"
            fill="#E8B455"
            letter-spacing="2"
          >
            ONE ECOSYSTEM
          </text>

          <path d="M460 90 V120" stroke="url(#archStroke)" stroke-width="2.2" stroke-linecap="round" />
          <path
            d="M210 120 H710"
            stroke="url(#archStroke)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-dasharray="6 6"
          />
          <path d="M210 120 V140" stroke="url(#archStroke)" stroke-width="2.2" stroke-linecap="round" />
          <path d="M460 120 V140" stroke="url(#archStroke)" stroke-width="2.2" stroke-linecap="round" />
          <path d="M710 120 V140" stroke="url(#archStroke)" stroke-width="2.2" stroke-linecap="round" />

          <rect x="70" y="140" width="280" height="90" rx="6" fill="#F7F4EE" stroke="#C4882A" stroke-opacity="0.35" />
          <text
            x="210"
            y="175"
            text-anchor="middle"
            font-family="Cormorant Garamond, Georgia, serif"
            font-size="20"
            fill="#09224A"
            font-weight="600"
          >
            Credit Risk Institute
          </text>
          <text
            x="210"
            y="202"
            text-anchor="middle"
            font-family="DM Sans, Arial, sans-serif"
            font-size="12"
            fill="#64748B"
          >
            Insight • Governance Visibility
          </text>

          <rect x="320" y="140" width="280" height="90" rx="6" fill="#F7F4EE" stroke="#C4882A" stroke-opacity="0.35" />
          <text
            x="460"
            y="175"
            text-anchor="middle"
            font-family="Cormorant Garamond, Georgia, serif"
            font-size="20"
            fill="#09224A"
            font-weight="600"
          >
            Risk Management Academy
          </text>
          <text
            x="460"
            y="202"
            text-anchor="middle"
            font-family="DM Sans, Arial, sans-serif"
            font-size="12"
            fill="#64748B"
          >
            Capability • Intelligence • Platform
          </text>

          <rect x="570" y="140" width="280" height="90" rx="6" fill="#F7F4EE" stroke="#C4882A" stroke-opacity="0.35" />
          <text
            x="710"
            y="175"
            text-anchor="middle"
            font-family="Cormorant Garamond, Georgia, serif"
            font-size="20"
            fill="#09224A"
            font-weight="600"
          >
            RMS Partnerships
          </text>
          <text
            x="710"
            y="202"
            text-anchor="middle"
            font-family="DM Sans, Arial, sans-serif"
            font-size="12"
            fill="#64748B"
          >
            Operational Strengthening • Support
          </text>
        </svg>

        <div class="arch-caption">
          From Insight → Capability → Execution. Institutions typically enter through the Academy capability platform
          and progress into governance visibility review and long-term operational strengthening.
        </div>
      </div>
    </div>
  </section>

  <section class="journey" id="journey">
    <div class="section-inner">
      <div class="section-tag reveal">Institutional engagement journey</div>
      <h2 class="section-heading reveal">Progressive institutional <em>strengthening</em></h2>
      <p class="section-sub reveal">
        A structured pathway from capability entry through governance visibility to operational strengthening and
        continuous ecosystem support.
      </p>

      <div class="journey-track reveal">
        <div class="journey-node">
          <div class="node-dot">0</div>
          <div class="node-title">Phase 0 · Capability Entry</div>
          <div class="node-desc">LMS capability entry &amp; institutional visibility.</div>
        </div>
        <div class="journey-node">
          <div class="node-dot">1</div>
          <div class="node-title">Phase 1 · Governance Visibility</div>
          <div class="node-desc">Structured governance visibility review.</div>
        </div>
        <div class="journey-node">
          <div class="node-dot">2</div>
          <div class="node-title">Phase 2 · Portfolio Visibility</div>
          <div class="node-desc">Portfolio risk visibility and emerging signals.</div>
        </div>
        <div class="journey-node">
          <div class="node-dot">3</div>
          <div class="node-title">Phase 3 · Operational Strengthening</div>
          <div class="node-desc">Structured operational strengthening engagements.</div>
        </div>
        <div class="journey-node">
          <div class="node-dot">4</div>
          <div class="node-title">Phase 4 · Continuous Support</div>
          <div class="node-desc">Continuous ecosystem support and reinforcement.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="lms-section" id="lms">
    <div class="section-inner">
      <div class="section-tag reveal">LMS capability entry</div>
      <h2 class="section-heading reveal">Capability and institutional <em>intelligence</em></h2>
      <p class="section-sub reveal">
        The capability platform is institutional intelligence infrastructure—it supports capability development,
        governance visibility, operational maturity identification, institutional participation insight, and structured
        learning consistency.
      </p>

      <LmsProgrammeBlock variant="homepage" />
    </div>
  </section>

  <section class="institutional" id="operational-strengthening">
    <div class="section-inner">
      <div class="institutional-inner">
        <div class="reveal">
          <div class="section-tag">Operational strengthening</div>
          <h2 class="section-heading">From capability to <em>institutional strengthening</em></h2>
          <p class="inst-desc">
            As institutions strengthen capability and governance visibility, KIPROD supports the transition into
            structured operational strengthening engagements through RMS Institutional Partnerships.
          </p>
          <div class="hero-actions" style="margin-top: 24px">
            <a href="/contact" class="btn-primary">Start Institutional Discussion →</a>
            <a href="/partnerships" class="btn-secondary">Explore RMS Partnerships →</a>
          </div>
        </div>
        <div class="inst-form reveal" style="padding: 34px">
          <div class="form-heading">RMS institutional partners gain</div>
          <div class="form-sub">Structured support across the engagement phases.</div>
          <ul class="bullets" style="margin-top: 0">
            <li><span class="dot"></span>Governance visibility across lending operations</li>
            <li><span class="dot"></span>Portfolio risk visibility and monitoring discipline</li>
            <li><span class="dot"></span>Operational execution and system strengthening</li>
            <li><span class="dot"></span>Structured borrower engagement and recovery</li>
            <li><span class="dot"></span>Continuous ecosystem advisory support</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="trust" id="trust">
    <div class="section-inner">
      <div class="trust-label reveal">Trust &amp; authority</div>
      <p class="trust-intro reveal">
        KIPROD is a new institutional credit risk ecosystem—building confidence through structured governance
        engagements, faculty-led capability development, and operational strengthening pathways.
      </p>

      <div class="trust-stats">
        <div class="trust-stat reveal">
          <div class="trust-stat-num">3</div>
          <div class="trust-stat-label">Integrated ecosystem pillars — Institute, Academy, RMS</div>
        </div>
        <div class="trust-stat reveal">
          <div class="trust-stat-num">7</div>
          <div class="trust-stat-label">Structured pathway — Modules 0–5 plus integrated simulation</div>
        </div>
        <div class="trust-stat reveal">
          <div class="trust-stat-num">5</div>
          <div class="trust-stat-label">RMS engagement phases — from governance review to continuous advisory</div>
        </div>
        <div class="trust-stat reveal">
          <div class="trust-stat-num">EA</div>
          <div class="trust-stat-label">Kenya first, East Africa sector focus</div>
        </div>
      </div>

      <div class="trust-grid reveal">
        <div class="trust-panel">
          <div class="trust-panel-title">Institutional partner categories</div>
          <ul class="trust-panel-list">
            <li>Commercial &amp; community banks</li>
            <li>SACCOs &amp; deposit-taking cooperatives</li>
            <li>Microfinance institutions</li>
            <li>Fintech &amp; digital lenders</li>
          </ul>
        </div>
        <div class="trust-panel">
          <div class="trust-panel-title">Governance engagements</div>
          <ul class="trust-panel-list">
            <li>Structured governance visibility reviews</li>
            <li>Executive and board-level briefings</li>
            <li>Portfolio risk visibility assessments</li>
            <li>Operational strengthening support</li>
          </ul>
        </div>
        <div class="trust-panel">
          <div class="trust-panel-title">Engagement types</div>
          <ul class="trust-panel-list">
            <li>Capability platform programmes</li>
            <li>Executive masterclasses and briefings</li>
            <li>Governance visibility reviews</li>
            <li>RMS institutional partnerships</li>
          </ul>
        </div>
      </div>

      <div class="trust-faculty reveal">
        <p>
          Faculty and institutional specialists lead capability development, governance engagements, and operational
          strengthening support across the ecosystem.
        </p>
        <a href="/academy#faculty" class="btn-secondary">Meet the faculty →</a>
      </div>

      <div class="trust-markets reveal">
        <div class="market-pill"><div class="market-dot"></div> Kenya</div>
        <div class="market-pill"><div class="market-dot"></div> Uganda</div>
        <div class="market-pill"><div class="market-dot"></div> Tanzania</div>
        <div class="market-pill"><div class="market-dot"></div> East Africa</div>
      </div>
    </div>
  </section>

  <section class="about" id="insights" style="background: var(--cream)">
    <div class="section-inner">
      <div class="section-tag reveal">Insights</div>
      <h2 class="section-heading reveal">Executive governance <em>intelligence</em></h2>
      <p class="section-sub reveal">
        Continuous thought leadership—governance perspectives, portfolio risk observations, and sector intelligence. Not
        a generic blog. Decision-useful insight for institutional leaders.
      </p>

      <InsightGrid posts={featuredInsights} columns={3} />

      <div style="margin-top: 28px" class="reveal">
        <a href="/insights" class="btn-secondary">View all insights →</a>
      </div>
    </div>
  </section>

  <section class="final-positioning" id="final-positioning" aria-label="Final positioning">
    <div class="section-inner">
      <p class="final-positioning-text reveal">
        KIPROD is institutional operating infrastructure—supporting financial institutions in strengthening credit risk
        governance, capability, operational execution, and portfolio resilience.
      </p>
      <p class="final-positioning-tagline reveal">From Insight → Capability → Execution.</p>
      <p class="final-positioning-closer reveal">
        Strengthening Credit Risk. Building Resilient Institutions.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-visual {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 136, 42, 0.2);
    border-radius: 4px;
    backdrop-filter: blur(8px);
    overflow: hidden;
    opacity: 0;
    animation: fadeLeft 0.9s 0.7s forwards;
  }
  .hero-visual-inner {
    padding: 36px;
  }
  .hero-visual-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--gold-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hero-visual-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .hero-visual-sub {
    font-size: 0.86rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 18px;
  }
  .hero-visual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .hero-visual-chip {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 12px;
    background: rgba(255, 255, 255, 0.04);
    border-left: 2px solid rgba(196, 136, 42, 0.35);
  }
  .chip-dot {
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }
  .chip-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 2px;
  }
  .chip-desc {
    font-size: 0.78rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.4;
  }

  .trust-faculty {
    margin-top: 28px;
    padding: 28px 32px;
    background: rgba(9, 34, 74, 0.04);
    border: 1px solid rgba(9, 34, 74, 0.08);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .trust-faculty p {
    margin: 0;
    max-width: 640px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(9, 34, 74, 0.72);
  }

  @media (max-width: 1024px) {
    .hero-visual {
      display: none;
    }
  }
</style>
