    <div class="section-tag">
      Latest From KIPROD
    </div>

    <h2 class="section-heading">
      Insights in <em>Action</em>
    </h2>

    <p class="section-sub">
      Explore executive interviews, institutional conversations,
      client testimonials and workshop highlights from across the
      KIPROD ecosystem.
    </p>

    <div class="download-grid">

      <!-- Video 1 -->

      <div class="video-card">

        <a
          href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
          target="_blank"
          class="video-thumb"
        >

          <img
            src="https://img.youtube.com/vi/2zCQtv5XnTY/hqdefault.jpg"
            alt="Executive Training"
          />

          <div class="play-icon">▶</div>

        </a>

        <div class="video-body">

          <div class="pill">
            Training
          </div>

          <h3>
            Executive Training
          </h3>

        </div>

      </div>

      <!-- Video 2 -->

      <div class="video-card">

        <a
          href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
          target="_blank"
          class="video-thumb"
        >

          <img
            src="https://img.youtube.com/vi/U2tD0JDMHTs/hqdefault.jpg"
            alt="Testimonial"
          />

          <div class="play-icon">▶</div>

        </a>

        <div class="video-body">

          <div class="pill">
            Testimonial
          </div>

          <h3>
            Institutional Experience
          </h3>

        </div>

      </div>

      <!-- Video 3 -->

      <div class="video-card">

        <a
          href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
          target="_blank"
          class="video-thumb"
        >

