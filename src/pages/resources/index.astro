---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CapabilityPlatformLink from "../../components/CapabilityPlatformLink.astro";
import AnimatedCounter from "../components/AnimatedCounter.astro";
---

<BaseLayout
  title="Resources – KIPROD"
  description="Institutional resources and downloads from KIPROD—organised by ecosystem pillar: Institute, Academy, and RMS Partnerships."
  activePath="/resources"
>
  <section class="hero hero-single">
    <div class="hero-grid"></div>
    <div class="hero-glow hero-glow-left"></div>

<div class="hero-glow hero-glow-right"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 70px">
      <h1 class="hero-heading">Resources &amp; <em>Downloads</em></h1>
      <div class="hero-divider"></div>
      <p class="hero-sub">
        Institutional assets across the KIPROD ecosystem—organised by pillar. Governance visibility materials, capability
        platform resources, and RMS partnership documents.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Start Institutional Discussion →</a>
        <CapabilityPlatformLink class="btn-secondary">Start Free Programme →</CapabilityPlatformLink>
      </div>
    </div>
  </section>

  <section class="about" style="background: var(--white)">
    <div class="section-inner">
      <div class="section-tag reveal">
    Corporate Resources
</div>

<h2 class="section-heading reveal">
    Corporate <em>Documents</em>
</h2>

<p class="section-sub reveal">
    Official institutional publications introducing KIPROD,
    its methodology, implementation framework and ecosystem.
</p>

      <div class="download-grid">

<div class="download-card reveal">

<div class="pill">
Corporate
</div>

<div class="download-title">
Company Profile
</div>

<div class="download-desc">
Overview of KIPROD, institutional methodology,
services, ecosystem and implementation approach.
</div>

<a class="arm-link" href="/downloads/company-profile.pdf">
Download PDF →
</a>

</div>

<div class="download-card reveal">

<div class="pill">
Corporate
</div>

<div class="download-title">
Institutional Methodology
</div>

<div class="download-desc">
ILCA → ICDF → ICAR →
Roadmap → Academy →
RMS → Command Centre.
</div>

<a class="arm-link">
Coming Soon
</a>

</div>

</div>
        <div class="download-card reveal">
          <div class="pill">RMS</div>
          <div class="download-title">
            <img class="icon" src="/assets/icons/monitoring.svg" alt="" />Case Study Template
          </div>
          <div class="download-desc">Standard structure: challenge → gaps → intervention → outcome.</div>
          <a class="arm-link" href="/downloads/Case_Study_Template_PLACEHOLDER.pdf" target="_blank" rel="noreferrer">
            Download PDF →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" style="background: var(--cream)">
  <div class="section-inner">

    <div class="section-tag reveal">
      Executive Briefs
    </div>

    <h2 class="section-heading reveal">
      Governance & Executive <em>Intelligence</em>
    </h2>

    <p class="section-sub reveal">
      Executive publications designed to support board oversight, governance
      visibility, portfolio monitoring, and informed institutional
      decision-making.
    </p>

    <div class="download-grid">

      <div class="download-card reveal">
        <div class="pill">Executive Brief</div>

        <div class="download-title">
          Governance Visibility Brief
        </div>

        <div class="download-desc">
          Understanding governance visibility and institutional oversight.
        </div>

        <a class="arm-link" href="#">
          Coming Soon →
        </a>
      </div>

      <div class="download-card reveal">
        <div class="pill">Executive Brief</div>

        <div class="download-title">
          Portfolio Risk Brief
        </div>

        <div class="download-desc">
          Executive observations on portfolio quality and emerging risk trends.
        </div>

        <a class="arm-link" href="#">
          Coming Soon →
        </a>
      </div>

      <div class="download-card reveal">
        <div class="pill">Executive Guide</div>

        <div class="download-title">
          Board Governance Guide
        </div>

        <div class="download-desc">
          Practical governance guidance for directors and executive leadership.
        </div>

        <a class="arm-link" href="#">
          Coming Soon →
        </a>
      </div>

    </div>

  </div>
</section>

  <section class="about" style="background: var(--white)">
  <div class="section-inner">

    <div class="section-tag reveal">
      Capability Development
    </div>

    <h2 class="section-heading reveal">
      Academy & Learning <em>Resources</em>
    </h2>

    <p class="section-sub reveal">
      Resources supporting institutional capability development,
      professional learning, and executive education.
    </p>

    <div class="download-grid">

      <div class="download-card reveal">
        <div class="pill">Academy</div>

        <div class="download-title">
          Academy Brochure
        </div>

        <div class="download-desc">
          Overview of programmes, learning pathways and certifications.
        </div>

        <a class="arm-link" href="#">
