---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Resources – KIPROD" description="Downloads, tools, and resources from KIPROD." activePath="/">
  <section class="hero" style="min-height: 46vh">
    <div class="hero-grid"></div>
    <div class="hero-inner" style="grid-template-columns: 1fr; padding-bottom: 70px">
      <h1 class="hero-heading">Resources &amp; <em>Downloads</em></h1>
      <p class="hero-sub">
        This hub will host publications, one‑pagers, templates, and tools. For now, you can access the Phase 1
        placeholder downloads from the homepage.
      </p>
      <div class="hero-actions">
        <a href="/#resources" class="btn-primary">Open downloads on homepage →</a>
        <a href="/contact" class="btn-secondary">Request a pack →</a>
      </div>
    </div>
  </section>

  <section class="about" style="background: var(--cream)">
    <div class="section-inner">
      <div class="section-tag reveal">Phase 1</div>
      <h2 class="section-heading reveal">Downloads (placeholders)</h2>
      <p class="section-sub reveal">
        These are the current placeholder PDFs already used on the homepage. Phase 2 will replace these with final
        branded assets and a proper resource library.
      </p>

      <div class="download-grid">
        <div class="download-card reveal">
          <div class="pill">Partnerships</div>
          <div class="download-title">
            <img class="icon" src="/assets/icons/partnerships.svg" alt="" />Institutional Partnership Brochure
          </div>
          <div class="download-desc">Explains the engagement model, diagnostics, and partnership structure.</div>
          <a
            class="arm-link"
            href="/downloads/Institutional_Credit_Risk_Strengthening_Partnership_Brochure_PLACEHOLDER.pdf"
            target="_blank"
            rel="noreferrer"
          >
            Download PDF →
          </a>
        </div>

        <div class="download-card reveal">
          <div class="pill">Lead-gen</div>
          <div class="download-title">
            <img class="icon" src="/assets/icons/governance.svg" alt="" />Governance Review One‑Pager
          </div>
          <div class="download-desc">A simple explainer: “What is a Credit Risk Governance Review?”</div>
          <a class="arm-link" href="/downloads/Credit_Risk_Governance_Review_One_Pager_PLACEHOLDER.pdf" target="_blank" rel="noreferrer">
            Download PDF →
          </a>
        </div>

        <div class="download-card reveal">
          <div class="pill">LMS</div>
          <div class="download-title">
            <img class="icon" src="/assets/icons/lms.svg" alt="" />LMS Welcome Pack
          </div>
          <div class="download-desc">Onboarding pack for institutions enrolling staff into the LMS.</div>
          <a class="arm-link" href="/downloads/LMS_Welcome_Pack_For_Institutions_PLACEHOLDER.pdf" target="_blank" rel="noreferrer">
            Download PDF →
          </a>
        </div>

        <div class="download-card reveal">
          <div class="pill">Proof</div>
          <div class="download-title">
            <img class="icon" src="/assets/icons/monitoring.svg" alt="" />Case Study Template
          </div>
          <div class="download-desc">Standard structure: challenge → gaps → intervention → outcome.</div>
          <a class="arm-link" href="/downloads/Case_Study_Template_PLACEHOLDER.pdf" target="_blank" rel="noreferrer">
            Download PDF →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

