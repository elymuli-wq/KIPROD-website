---
import type { CollectionEntry } from "astro:content";
import { insightSlug, topicLabel } from "../lib/insights";

interface Props {
  posts: CollectionEntry<"insights">[];
  columns?: 2 | 3;
  showTopic?: boolean;
}

const { posts, columns = 2, showTopic = true } = Astro.props;
---

<div class={`download-grid insight-grid insight-grid--${columns}`}>
  {
    posts.map((post) => (
      <div class="download-card reveal">
        <div class="pill">
          {showTopic ? topicLabel(post.data.topic) : post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })}
        </div>
        <div class="download-title">{post.data.title}</div>
        <div class="download-desc">{post.data.description}</div>
        <a class="arm-link" href={`/insights/${insightSlug(post)}`}>Read insight →</a>
      </div>
    ))
  }
</div>
