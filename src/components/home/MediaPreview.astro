<section class="media-home">

  <div class="section-inner">

    <div class="section-tag reveal">
      Latest From KIPROD
    </div>

    <h2 class="section-heading reveal">
      Executive <em>Conversations & Insights</em>
    </h2>

    <p class="section-sub reveal">
      Discover executive interviews, institutional success stories,
      professional workshops and capability development sessions from
      across the KIPROD ecosystem.
    </p>

    <div class="download-grid">

      <!-- Training -->

      <div class="video-card reveal">

        <a
          href="https://www.youtube.com/watch?v=2zCQtv5XnTY"
          target="_blank"
          class="video-thumb"
        >

          <img
            src="https://img.youtube.com/vi/2zCQtv5XnTY/hqdefault.jpg"
            alt="Executive Training"
          />

          <div class="play-icon">▶</div>

        </a>

        <div class="video-body">

          <div class="pill">
            Training
          </div>

          <h3>
            Executive Training
          </h3>

          <p>
            Professional capability development for financial institutions.
          </p>

        </div>

      </div>

      <!-- Testimonial -->

      <div class="video-card reveal">

        <a
          href="https://www.youtube.com/watch?v=U2tD0JDMHTs"
          target="_blank"
          class="video-thumb"
        >

          <img
            src="https://img.youtube.com/vi/U2tD0JDMHTs/hqdefault.jpg"
            alt="Institutional Testimonial"
          />

          <div class="play-icon">▶</div>

        </a>

        <div class="video-body">

          <div class="pill">
            Testimonial
          </div>

          <h3>
            Institutional Experience
          </h3>

          <p>
            Hear directly from institutions that have partnered with KIPROD.
          </p>

        </div>

      </div>

      <!-- Workshop -->

      <div class="video-card reveal">

        <a
          href="https://www.youtube.com/watch?v=7VfeeHqbAeY"
          target="_blank"
          class="video-thumb"
        >

          <img
            src="https://img.youtube.com/vi/7VfeeHqbAeY/hqdefault.jpg"
            alt="Workshop Highlights"
          />

          <div class="play-icon">▶</div>

        </a>

        <div class="video-body">

          <div class="pill">
            Workshop
          </div>

          <h3>
            Workshop Highlights
          </h3>

          <p>
            Highlights from executive workshops, governance sessions and institutional learning.
          </p>

        </div>

      </div>

    </div>

    <div style="margin-top:50px;text-align:center;" class="reveal">

      <a
        href="/media"
        class="btn-secondary"
      >
        Explore the Media Centre →
      </a>

    </div>

  </div>

</section>