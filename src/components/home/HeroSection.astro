<style>
  .hero-visual {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 136, 42, 0.2);
    border-radius: 4px;
    backdrop-filter: blur(8px);
    overflow: hidden;
    opacity: 0;
    animation: fadeLeft 0.9s 0.7s forwards;
  }

  .hero-visual-inner {
    padding: 36px;
  }

  .hero-visual-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--gold-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .hero-visual-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .hero-visual-sub {
