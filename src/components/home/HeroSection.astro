---

---

<section class="hero" id="top">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/abstract-network-optimized.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>
  <div class="hero-grid"></div>
  <div class="hero-glow hero-glow-left"></div>

<div class="hero-glow hero-glow-right"></div>

  <div class="hero-inner">

  <!-- LEFT CONTENT -->
  <div class="hero-text">

    <h1 class="hero-heading">
      Strengthening <em>Credit Risk</em>. Building
      <em>Resilient Institutions</em>.
    </h1>

    <div class="hero-divider"></div>

    <p class="hero-sub">
      Every institution is different. Before recommending learning,
      advisory, or implementation support, KIPROD helps institutions
      understand their current capability, identify strategic priorities,
      and develop a structured roadmap for institutional strengthening.
    </p>

    <p class="hero-insight">
      Sustainable institutional improvement begins with understanding—not
      assumptions. Our methodology combines governance insight,
      capability discovery, evidence-based assessment, and execution
      support to help institutions move from diagnosis to measurable
      performance improvement.
    </p>

    <div class="hero-actions">

      <a
        href="/contact?assessment=ilca"
        class="btn-primary"
      >
        Start Institutional Capability Assessment →
      </a>

      <a
        href="/#ecosystem"
        class="btn-secondary"
      >
        Explore the KIPROD Ecosystem
        <span class="btn-arrow">→</span>
      </a>

    </div>

  </div>

  <!-- RIGHT VISUAL -->
  <div
    class="hero-visual"
    aria-label="KIPROD Institutional Engagement Methodology"
  >

    <div class="hero-visual-inner">

      <div class="hero-visual-label">
        Institutional Methodology
      </div>

      <div class="hero-visual-title">
        From Understanding → Implementation →
        Continuous Improvement
      </div>

      <div class="hero-visual-sub">
        Every institutional engagement follows a structured methodology
        that begins with capability understanding and progresses through
        assessment, roadmap development, implementation, and continuous
        performance improvement.
      </div>

      <div class="methodology-flow" role="list">

        <div class="flow-step" role="listitem">
          <div class="step-number">1</div>

          <div class="step-content">
            <div class="step-title">
              Institutional Learning & Capability Assessment
            </div>

            <div class="step-code">
              ILCA
            </div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step" role="listitem">
          <div class="step-number">2</div>

          <div class="step-content">
            <div class="step-title">
              Institutional Capability Discovery Framework
            </div>

            <div class="step-code">
              ICDF
            </div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step" role="listitem">
          <div class="step-number">3</div>

          <div class="step-content">
            <div class="step-title">
              Institutional Capability Assessment Report
            </div>

            <div class="step-code">
              ICAR
            </div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step" role="listitem">
          <div class="step-number">4</div>

          <div class="step-content">
            <div class="step-title">
              Learning & Advisory Roadmap
            </div>

            <div class="step-code">
              Roadmap
            </div>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-pillars">
          <span>Academy</span>
          <span>RMS</span>
          <span>Command Centre</span>
        </div>

      </div>

    </div>

  </div>

</div> <!-- END hero-inner -->

<!-- TRUST BAR -->
<div class="hero-trust reveal">

  <div class="hero-trust-item">
    ✓ Financial Institutions
  </div>

  <div class="hero-trust-item">
    ✓ Government Agencies
  </div>

  <div class="hero-trust-item">
    ✓ Professional Bodies
  </div>

  <div class="hero-trust-item">
    ✓ Executive Leadership
  </div>

</div>

</section>

<!-- LOGO STRIP -->

<section class="logo-strip">

  <div class="section-inner">

    <p class="logo-heading">
      Institutions represented across our engagements
    </p>

    <div class="logo-grid">

      <div>KRA</div>
      <div>Family Bank</div>
      <div>Stima SACCO</div>
      <div>NITA</div>

      <div>Microfinance</div>
      <div>SACCOs</div>
      <div>Banks</div>
      <div>Government</div>

    </div>

  </div>

</section>
<style>
  .hero-visual{
  background:rgba(9,28,52,.72);
  border:1px solid rgba(196,136,42,.28);
  border-radius:18px;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,.35);
  opacity:0;
  animation:fadeLeft .9s .7s forwards;
}

.hero-visual-inner{
  padding:clamp(24px,3vw,40px);
}

.hero-visual-label{
  display:inline-block;
  margin-bottom:14px;
  padding:6px 12px;
  border-radius:999px;
  background:rgba(196,136,42,.12);
  border:1px solid rgba(196,136,42,.25);
  font-family:var(--font-mono);
  font-size:.72rem;
  font-weight:600;
  color:var(--gold-light);
  letter-spacing:.12em;
  text-transform:uppercase;
}

.hero-visual-title{
  font-family:var(--font-display);
  font-size:clamp(1.45rem,2vw,2rem);
  line-height:1.25;
  font-weight:600;
  color:#fff;
  margin-bottom:16px;
}

.hero-visual-sub{
  font-size:1rem;
  line-height:1.8;
  color:rgba(255,255,255,.82);
  margin-bottom:28px;
  max-width:42ch;
}

@media (max-width:1200px){
  .hero-visual-inner{
    padding:28px;
  }

  .hero-visual-title{
    font-size:1.5rem;
  }

  .hero-visual-sub{
    font-size:.95rem;
  }
}

@media (max-width:1024px){
  .hero-visual{
    display:none;
  }
}

  /* NEW METHODOLOGY FLOW */
  .methodology-flow {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .flow-step{

padding:18px;

border-radius:12px;

background:rgba(255,255,255,.06);

border:1px solid rgba(255,255,255,.08);

border-left:4px solid var(--gold);

transition:.3s;

}
.flow-step:hover{

transform:translateX(6px);

background:rgba(255,255,255,.08);

}

  .step-number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--white);
    line-height: 1.35;
    margin-bottom: 4px;
  }

  .step-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flow-arrow {
    text-align: center;
    color: var(--gold);
    font-size: 1rem;
    opacity: 0.8;
  }

  .flow-pillars {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 8px;
  }

  .flow-pillars span {
    padding: 8px 12px;
    border: 1px solid rgba(196, 136, 42, 0.3);
    background: rgba(196, 136, 42, 0.08);
    color: var(--gold-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .hero-visual {
      display: none;
    }
  }

 .hero-trust{

position:relative;
z-index:5;

max-width:1200px;
margin:-35px auto 60px;

padding:0 24px;

display:flex;
flex-wrap:wrap;
justify-content:center;
gap:18px;

}

.hero-trust-item{

background:white;

color:var(--navy);

border:1px solid rgba(196,136,42,.25);

box-shadow:0 15px 35px rgba(0,0,0,.08);

padding:16px 24px;

font-weight:600;

border-radius:999px;

}

.hero-trust-item:hover{
  background:var(--gold);
  color:white;
  transform:translateY(-4px);
  box-shadow:0 18px 40px rgba(0,0,0,.12);
}

/* ===========================
   TABLETS
=========================== */

@media(max-width:768px){

  .hero-trust{
    gap:12px;
    margin:32px auto 48px;
  }

  .hero-trust-item{
    width:100%;
    min-width:0;
    font-size:.9rem;
  }

}

/* ===========================
   SMALL PHONES
=========================== */

@media (max-width:480px){

  .hero-trust{
    flex-direction:column;
    align-items:stretch;
    gap:10px;
    padding:0;
  }

  .hero-trust-item{
    width:100%;
    text-align:center;
    white-space:normal;
    padding:12px 18px;
  }

}

.hero-trust-item{
    width:100%;
    text-align:center;
}
.logo-strip{

padding:80px 0 60px;

background:white;

}
.logo-heading{

text-align:center;

color:#777;

margin-bottom:24px;

font-size:.95rem;

letter-spacing:1px;

text-transform:uppercase;

}

.logo-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:24px;
}

@media (max-width:1024px){

.logo-grid{

grid-template-columns:repeat(2,1fr);

}

}

@media (max-width:640px){

.logo-grid{

grid-template-columns:1fr;

gap:18px;

}

.logo-grid div{

padding:20px;

font-size:.95rem;

}

}

.logo-grid div{

padding:28px;

border:1px solid #eee;

border-radius:12px;

text-align:center;

font-weight:700;

font-size:1rem;

background:#fafafa;

transition:.3s;

}

.logo-grid div:hover{

transform:translateY(-5px);

box-shadow:0 20px 50px rgba(0,0,0,.08);

}
</style>
