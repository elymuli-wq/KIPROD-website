    border: 1px solid rgba(196, 136, 42, 0.3);
    background: rgba(196, 136, 42, 0.08);
    color: var(--gold-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
