    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  /* NEW METHODOLOGY FLOW */
  .methodology-flow {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .flow-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px;
    background: rgba(255, 255, 255, 0.04);
    border-left: 3px solid rgba(196, 136, 42, 0.45);
  }

  .step-number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--white);
    line-height: 1.35;
    margin-bottom: 4px;
  }

  .step-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flow-arrow {
    text-align: center;
    color: var(--gold);
    font-size: 1rem;
    opacity: 0.8;
  }

  .flow-pillars {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 8px;
  }

  .flow-pillars span {
