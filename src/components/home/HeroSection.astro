---
import CapabilityPlatformLink from "../CapabilityPlatformLink.astro";
---
<section class="hero" id="top">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/videos/abstract-network-optimized.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-glow-2"></div>

    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-heading">
  Building <em>Stronger Institutions</em> Through
  Governance, Risk & Capability Development.
</h1>
        <p class="hero-sub">
  KIPROD is an integrated institutional ecosystem supporting governance, risk management, professional capability development, digital learning, research, publications, and strategic partnerships for financial institutions.
</p>
        <p class="hero-insight">
  Sustainable institutional performance is achieved through strong governance, capable people, effective systems, continuous learning, and informed decision-making.
</p>
        <div class="hero-actions">
          <CapabilityPlatformLink class="btn-primary">
    Explore the Academy →
</CapabilityPlatformLink>
          <a href="/contact" class="btn-secondary">
            Start Institutional Discussion <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="KIPROD overview visual">
        <div class="hero-visual-inner">
          <div class="hero-visual-label">Institutional pathways</div>
          <div class="hero-visual-title">
Institute • Academy • LMS • RMS Partnerships
</div>
          <div class="hero-visual-sub">Supporting institutions through governance, learning, research, capability development and strategic partnerships.</div>

          <div class="hero-visual-grid" role="list">
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Insight</div>
                <div class="chip-desc">Governance visibility &amp; executive intelligence</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Capability</div>
                <div class="chip-desc">Institutional capability development</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Visibility</div>
                <div class="chip-desc">Structured governance visibility review</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Strengthen</div>
                <div class="chip-desc">Operational strengthening support</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Sustain</div>
                <div class="chip-desc">Continuous ecosystem support</div>
              </div>
            </div>
            <div class="hero-visual-chip" role="listitem">
              <div class="chip-dot"></div>
              <div>
                <div class="chip-title">Two pathways</div>
                <div class="chip-desc">Programme entry + institutional discussion</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
  .hero-visual {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 136, 42, 0.2);
    border-radius: 4px;
    backdrop-filter: blur(8px);
    overflow: hidden;
    opacity: 0;
    animation: fadeLeft 0.9s 0.7s forwards;
  }
  .hero-visual-inner {
    padding: 36px;
  }
  .hero-visual-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--gold-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hero-visual-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .hero-visual-sub {
    font-size: 0.86rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 18px;
  }
  .hero-visual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .hero-visual-chip {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 12px;
    background: rgba(255, 255, 255, 0.04);
    border-left: 2px solid rgba(196, 136, 42, 0.35);
  }
  .chip-dot {
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--gold);
    flex-shrink: 0;
  }
  .chip-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 2px;
  }
  .chip-desc {
    font-size: 0.78rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.4;
  }
  @media (max-width: 1024px) {
    .hero-visual {
      display: none;
    }
  }