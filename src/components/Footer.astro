---
import CapabilityPlatformLink from "./CapabilityPlatformLink.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About KIPROD" },
  { href: "/#ecosystem", label: "Our Ecosystem" },
  { href: "/academy", label: "Academy" },
  { href: "/institute", label: "Institute" },
  { href: "/insights", label: "Insights" },
  { href: "/contact", label: "Contact" },
];
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <div class="footer-brand-logo">
          <img
            src="/assets/kiprod-logo-2026.png"
            alt="KIPROD"
            class="brand-logo-img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="footer-brand-desc">
          Strengthening Credit Risk. Building Resilient Institutions. From Insight → Capability → Execution.
        </div>
      </div>

      <div>
        <div class="footer-col-title">Navigation</div>
        <ul class="footer-links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="footer-col-title">Ecosystem</div>
        <ul class="footer-links">
          <li>
            <a href="/partnerships">RMS Institutional Partnerships</a>
          </li>
          <li>
            <CapabilityPlatformLink>Start Free Programme</CapabilityPlatformLink>
          </li>
          <li>
            <a href="/resources">Resources &amp; Downloads</a>
          </li>
          <li>
            <a href="/contact">Start Institutional Discussion</a>
          </li>
        </ul>
      </div>

      <div>
        <div class="footer-col-title">Markets</div>
        <ul class="footer-links">
          <li><a href="/#trust">Kenya</a></li>
          <li><a href="/#trust">Uganda</a></li>
          <li><a href="/#trust">Tanzania</a></li>
          <li><a href="/#trust">East Africa</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">© 2026 KIPROD. All rights reserved.</div>
      <div class="footer-markets">Banks · SACCOs · Microfinance · Fintech</div>
    </div>
  </div>
</footer>
