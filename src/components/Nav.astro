---
import CapabilityPlatformLink from "./CapabilityPlatformLink.astro";

const { activePath = "/" } = Astro.props;

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About KIPROD" },
  { href: "/#ecosystem", label: "Our Ecosystem" },
  { href: "/academy", label: "Academy" },
  { href: "/institute", label: "Institute" },
  { href: "/insights", label: "Insights" },
  { href: "/contact", label: "Contact" },
];
---

<nav>
  <a class="nav-logo" href="/" aria-label="KIPROD home">
    <img
      src="/assets/kiprod-logo-2026.png"
      alt="KIPROD"
      class="brand-logo-img"
      loading="eager"
      decoding="async"
    />
  </a>
  <ul class="nav-links">
    {
      links.map((l) => (
        <li>
          <a href={l.href} class={activePath === l.href ? "nav-link-active" : undefined}>
            {l.label}
          </a>
        </li>
      ))
    }
    <li>
      <CapabilityPlatformLink class="nav-cta">Start Free Programme →</CapabilityPlatformLink>
    </li>
  </ul>
</nav>
